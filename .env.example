APP_NAME="Monitoring Operation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://monitoringops-academy.first-resources.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL recommended for Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_peta_sdm
DB_USERNAME=root
DB_PASSWORD=

# Session & Cookie Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=petasdm_session
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@first-resources.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# INTEGRASI PORTAL FR ACADEMY (TRAINING DATA SYNC)
# ==============================================================================
# Base URL Portal FR Academy (tanpa trailing slash)
PORTAL_API_URL=https://academy.first-resources.com

# Bearer Token API dari Portal FR Academy (Sanctum / Personal Access Token)
PORTAL_API_TOKEN=

# Request timeout dalam detik (default 30-60)
PORTAL_API_TIMEOUT=60

# Verifikasi sertifikat SSL saat memanggil API Portal (true/false)
PORTAL_API_VERIFY_SSL=true

# Sinkronisasi otomatis via scheduler cron (true/false)
PORTAL_SYNC_ENABLED=true

# Waktu sinkronisasi harian (Format: HH:mm dalam WIB)
PORTAL_SYNC_TIME=02:00

# Pengaman rasio minimal data ditarik sebelum replace lokal (0.8 = minimal 80% dari total sebelumnya)
PORTAL_SYNC_MIN_RATIO=0.8

# ==============================================================================
# CLOUDFLARE TURNSTILE (CAPTCHA LOGIN)
# ==============================================================================
# Aktifkan verifikasi bot Cloudflare Turnstile pada halaman login (true/false)
TURNSTILE_ENABLED=true

# Site Key Turnstile (Public Key untuk widget frontend)
TURNSTILE_SITE_KEY=0x4AAAAAAEzPGJLBNyo86KAl

# Secret Key Turnstile (Private Key untuk verifikasi backend)
TURNSTILE_SECRET_KEY=0x4AAAAAAEzPGKSsKiRsoVbsX1tzF-N7x8k

# Verifikasi sertifikat SSL saat menghubungi endpoint Cloudflare (true/false)
TURNSTILE_VERIFY_SSL=true




